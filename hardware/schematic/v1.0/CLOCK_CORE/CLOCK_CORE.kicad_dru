(version 1)
# 细间距封装焊盘之间的间距由封装本身决定（0.5mm 引脚间距），不套用网络类间距
(rule "fp_pad_to_pad"
  (constraint clearance (min 0.2mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent"))
# U5 (VQFN-48, 0.5mm) 扇出区 LOOP/REF_IN 无法满足 0.3mm，放宽到 0.2mm（嘉立创下限 0.09mm）
(rule "U5_fanout"
  (constraint clearance (min 0.2mm))
  (condition "A.intersectsCourtyard('U5') && B.intersectsCourtyard('U5')"))
(rule "CLK_OUT_to_pour"
  (constraint clearance (min 0.3mm))
  (condition "A.NetClass == 'CLK_OUT' && B.Type == 'Zone'"))
